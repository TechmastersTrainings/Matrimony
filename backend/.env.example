# ==========================================
# Backend Environment Configuration Template
# (Do NOT put actual production secrets in this file. Copy to .env)
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME="Christian Matrimony Backend API"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]
LOG_LEVEL=INFO

# Database (Aiven MySQL)
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?ssl_ca=<SSL_CA_PATH>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis (Upstash Redis)
REDIS_URL=rediss://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>
REDIS_TOKEN=your_upstash_redis_token_here

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=christian-matrimony-media
R2_PUBLIC_URL=https://media.christianmatrimony.app

# Monitoring & Error Reporting
SENTRY_DSN=

# Future Phase Service Abstraction Placeholders
INDIAN_SMS_PROVIDER_API_KEY=
UPI_PAYMENT_GATEWAY_KEY=
UPI_PAYMENT_GATEWAY_SECRET=
FIREBASE_CREDENTIALS_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
