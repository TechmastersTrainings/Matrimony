# ==========================================
# Backend Environment Configuration Template
# (Do NOT put actual production secrets in this file. Copy to .env)
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME="Christian Matrimony Backend API"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]
LOG_LEVEL=INFO

# Database (Aiven MySQL / Managed MySQL)
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?ssl-mode=REQUIRED
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis (Upstash Redis)
REDIS_URL=rediss://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>
REDIS_TOKEN=your_upstash_redis_token_here

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=christian-matrimony-media

# Add after the actual matrimony domain is purchased
# and the R2 custom domain is configured.
R2_PUBLIC_URL=

# Monitoring & Error Reporting
SENTRY_DSN=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Indian Live SMS & OTP Gateway (Fast2SMS / MSG91 / Twilio)
INDIAN_SMS_PROVIDER_API_KEY=your_sms_gateway_api_key_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
OTP_TEST_MODE=False

# Email Delivery (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Christian Matrimony"

# Super Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=9880768222
ADMIN_PASSWORD=your_secure_admin_password

